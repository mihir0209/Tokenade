# Copy to .env (gitignored). Never commit real secrets.
# Used by scripts/apply_supabase_schema.py for private share-store setup.

# Postgres URI from Supabase Dashboard -> Project Settings -> Database
# (Session mode or direct; use the password you set at project creation.)
DATABASE_URL=postgresql://postgres.YOUR_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Optional aliases
# SUPABASE_DB_URL=
# TOKENADE_DATABASE_URL=

# Client (anon/publishable) — safe in app config; NOT the service_role key
# SUPABASE_URL=https://YOUR_REF.supabase.co
# SUPABASE_ANON_KEY=sb_publishable_...
# TOKENADE_SUPABASE_URL=
# TOKENADE_SUPABASE_ANON_KEY=
